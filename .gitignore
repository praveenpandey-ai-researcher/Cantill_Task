# ---- Task data: confidential, NEVER commit ----
data/
company_A/
company_B/
company_C/
*.pdf
# Any CSV is treated as data by default...
*.csv
*.xlsx
*.xls
*.parquet
# ...except our own pipeline outputs, which must be in the repo.
!outputs/*.csv
!submission/*.csv

# ---- Caches and models ----
.cache/
cache/
*.npy
*.pkl
*.joblib
*.safetensors
*.bin
*.pt
models/

# ---- Secrets ----
.env
.env.*

# ---- Python / tooling ----
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.vscode/
.idea/
.claude/

# ---- Run artefacts (reports are regenerated each run) ----
logs/
*.log
